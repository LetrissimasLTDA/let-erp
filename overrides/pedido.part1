<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="favicon.png"><link rel="stylesheet" href="factory-suite.css?v=37"><script src="theme.js?v=37"></script><title>LET ERP • Central do Pedido</title><style>
.hero{display:grid;grid-template-columns:110px 1fr auto;gap:14px;align-items:center}.hero-logo{width:108px;height:108px;border:1px solid #dbe5e8;border-radius:14px;background:#f8fafc;display:grid;place-items:center;overflow:hidden;color:#94a3b8;font-weight:950}.hero-logo img{width:100%;height:100%;object-fit:contain}.hero h1{font-size:24px;margin:0}.hero .client{font-size:18px;font-weight:950;margin-top:4px}.hero-meta{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}.hero-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.pinned{border-left:6px solid #f59e0b;background:#fffbeb;border-radius:0 12px 12px 0;padding:11px;margin-top:12px}.tag-list{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.tag-item{display:inline-flex;align-items:center;gap:5px;background:#dbeafe;color:#1d4ed8;border-radius:999px;padding:5px 8px;font-size:8px;font-weight:950}.tag-item button{border:0;background:transparent;color:#991b1b;cursor:pointer;font-weight:950}.comment{display:grid;grid-template-columns:40px 1fr;gap:9px;border-bottom:1px solid #e5e7eb;padding:10px 0}.comment strong{font-size:10px}.comment p{margin:4px 0 0;font-size:10px;white-space:pre-wrap;line-height:1.45}.comment time{font-size:8px;color:#94a3b8}.mention-wrap{position:relative}.mention-box{display:none;position:absolute;left:0;right:0;bottom:100%;max-height:180px;overflow:auto;background:#fff;border:1px solid #cbd5e1;border-radius:10px;box-shadow:0 12px 30px rgba(15,23,42,.18);z-index:20}.mention-box.show{display:block}.mention-item{padding:8px 10px;cursor:pointer;font-size:9px;font-weight:850}.mention-item:hover{background:#ecfeff}.files{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.file{border:1px solid #e2e8f0;border-radius:12px;padding:10px}.file strong{font-size:9px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.file small{font-size:8px;color:#64748b}.timeline{display:grid;gap:7px}.event{border-left:4px solid #2dd4cf;background:#f8fafc;padding:9px 10px;border-radius:0 9px 9px 0;font-size:9px}.quality-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.quality-item{display:flex;align-items:center;gap:8px;border:1px solid #e2e8f0;border-radius:10px;padding:10px;font-size:10px;font-weight:850}.quality-item input{width:18px;height:18px}.stock-row{display:grid;grid-template-columns:1fr 100px auto;gap:7px;align-items:end;margin-bottom:8px}.stock-link{display:flex;justify-content:space-between;gap:8px;border:1px solid #e2e8f0;border-radius:10px;padding:9px;margin-top:7px}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.summary-box{border:1px solid #e2e8f0;border-radius:11px;padding:10px}.summary-box small{font-size:8px;color:#64748b;font-weight:950}.summary-box b{display:block;margin-top:4px;font-size:11px}.danger-zone{border:1px solid #fecaca;background:#fff7f7;border-radius:12px;padding:12px}.file-upload{border:1px dashed #94a3b8;border-radius:12px;padding:12px;background:#f8fafc;margin-bottom:10px}@media(max-width:900px){.hero{grid-template-columns:90px 1fr}.hero-actions{grid-column:1/-1;justify-content:flex-start}.files{grid-template-columns:repeat(2,1fr)}.summary-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hero{grid-template-columns:1fr}.hero-logo{width:100%;height:180px}.files,.quality-grid,.summary-grid{grid-template-columns:1fr}.stock-row{grid-template-columns:1fr}}</style></head><body><header class="topbar"><div><h1>📌 Central do Pedido</h1><p>Comentários, arquivos, qualidade, estoque, histórico e impressão</p></div><a class="btn dark" href="painel_producao.html">← PAINEL</a></header><main class="page"><div class="notice" id="notice"></div><section class="panel" id="hero"><div class="empty">Carregando pedido...</div></section><div class="tabs" style="margin-top:14px"><button class="tab active" data-tab="resumo">RESUMO</button><button class="tab" data-tab="comentarios">💬 COMENTÁRIOS</button><button class="tab" data-tab="arquivos">📎 ARQUIVOS</button><button class="tab" data-tab="qualidade">✅ QUALIDADE</button><button class="tab" data-tab="estoque">📦 ESTOQUE</button><button class="tab" data-tab="historico">🔄 HISTÓRICO</button></div><section class="panel tab-panel active" id="tab-resumo"></section><section class="panel tab-panel" id="tab-comentarios"><div id="comments"></div><div class="mention-wrap" style="margin-top:10px"><div class="mention-box" id="mentionBox"></div><textarea class="textarea" id="commentText" style="width:100%" placeholder="Escreva um comentário. Use @ para mencionar um funcionário..."></textarea></div><button class="btn dark" id="sendComment" style="margin-top:8px">ENVIAR COMENTÁRIO</button></section><section class="panel tab-panel" id="tab-arquivos"><div class="file-upload"><div class="grid2"><div class="field"><label>ARQUIVOS</label><input class="input" id="fileInput" type="file" multiple></div><div class="field"><label>DESCRIÇÃO</label><input class="input" id="fileDesc" placeholder="Ex.: Arquivo de corte, aprovação..."></div></div><button class="btn dark" id="uploadFiles" style="margin-top:8px">ENVIAR ARQUIVOS</button></div><div class="files" id="files"></div></section><section class="panel tab-panel" id="tab-qualidade"><div class="toolbar"><div><h2>Checklist antes de finalizar</h2><div class="muted" style="font-size:9px">Todos os itens precisam ser conferidos.</div></div><span id="qualityStatus"></span></div><div class="quality-grid" id="qualityGrid" style="margin-top:12px"></div><button class="btn dark" id="saveQuality" style="margin-top:10px">SALVAR CHECKLIST</button></section><section class="panel tab-panel" id="tab-estoque"><div class="toolbar"><h2>Materiais vinculados ao pedido</h2><span id="stockStatus"></span></div><div class="stock-row" style="margin-top:12px"><div class="field"><label>ITEM DO ESTOQUE</label><select class="select" id="stockItem"></select></div><div class="field"><label>QTD.</label><input class="input" id="stockQty" type="number" min="1" value="1"></div><button class="btn dark" id="addStock">ADICIONAR</button></div><div id="stockLinks"></div><button class="btn yellow" id="deductStock" style="margin-top:10px">BAIXAR ESTOQUE AGORA</button></section><section class="panel tab-panel" id="tab-historico"><div class="toolbar"><div><h2>Linha do tempo completa</h2><div class="muted" style="font-size:9px">Alterações, etapas, atrasos e produção</div></div><button class="btn red" id="undoBtn">↩ DESFAZER ÚLTIMA AÇÃO</button></div><div class="timeline" id="timeline" style="margin-top:12px"></div></section></main><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script src="supabase-config.js?v=37"></script><script src="factory-suite.js?v=37"></script><script>
const db=letErpSupabase;const id=new URLSearchParams(location.search).get('id');let order=null,profiles=[],profileMap={},comments=[],files=[],audit=[],stages=[],stock=[],stockLinks=[],currentUser=null,perms={};const qualityItems={medidas:'Medidas conferidas',cor:'Cor correta',espessura:'Espessura correta',acabamento:'Acabamento aprovado',pecas:'Peças completas',pintura:'Pintura aprovada',embalagem:'Embalagem conferida',foto:'Foto final conferida'};
function pName(uid){return profileMap[uid]?.nome||profileMap[uid]?.email||'Funcionário'}function array(v){return Array.isArray(v)?v:[]}
function renderHero(){const img=order.imagem?'<img src="'+erpEsc(order.imagem)+'">':'LOGO';document.getElementById('hero').innerHTML='<div class="hero"><div class="hero-logo">'+img+'</div><div><h1>Pedido #'+erpEsc(order.id)+'</h1><div class="client">'+erpEsc(order.cliente||'Sem cliente')+'</div><div class="hero-meta">'+erpPriorityChip(order.prioridade)+(order.marketplace?'<span class="chip aqua">'+erpEsc(order.marketplace)+'</span>':'')+(order.espessura?'<span class="chip">'+erpEsc(order.espessura)+'</span>':'')+(order.medidas?'<span class="chip">'+erpEsc(order.medidas)+'</span>':'')+'<span class="chip blue">'+erpEsc(ERP_STAGES[order.etapa_atual||0])+'</span></div></div><div class="hero-actions"><button class="btn gray" onclick="printSheet()">🖨️ FICHA</button><button class="btn gray" onclick="printLabel()">🏷️ ETIQUETA</button><a class="btn aqua" href="painel_producao.html?pedido='+encodeURIComponent(order.id)+'">PAINEL</a></div></div>'}
function renderSummary(){const resp=profileMap[order.responsavel_atual];const tags=array(order.etiquetas);document.getElementById('tab-resumo').innerHTML='<div class="grid2"><div><div class="field"><label>PRIORIDADE</label><select class="select" id="priority"><option>Normal</option><option>Urgente</option><option>Crítico</option></select></div><div class="field" style="margin-top:9px"><label>RESPONSÁVEL ATUAL</label><select class="select" id="responsible"><option value="">Sem responsável</option>'+profiles.map(p=>'<option value="'+p.id+'">'+erpEsc(p.nome||p.email)+' • '+erpEsc(p.setor||'')+'</option>').join('')+'</select></div><button class="btn dark" id="saveSummary" style="margin-top:9px">SALVAR</button></div><div><div class="summary-grid"><div class="summary-box"><small>ETAPA</small><b>'+erpEsc(ERP_STAGES[order.etapa_atual||0])+'</b></div><div class="summary-box"><small>RESPONSÁVEL</small><b>'+erpEsc(resp?.nome||order.producao_operador_atual||'Não definido')+'</b></div><div class="summary-box"><small>SAÍDA</small><b>'+erpBr(order.prazo)+'</b></div><div class="summary-box"><small>QUALIDADE</small><b>'+(order.qualidade_aprovado?'APROVADO':'PENDENTE')+'</b></div><div class="summary-box"><small>ESTOQUE</small><b>'+(order.estoque_baixado?'BAIXADO':'PENDENTE')+'</b></div><div class="summary-box"><small>EXPEDIÇÃO</small><b>'+erpEsc(order.expedicao_status||'-')+'</b></div></div></div></div><div class="pinned"><div class="field"><label>📌 OBSERVAÇÃO FIXADA</label><textarea class="textarea" id="pinned" style="min-height:65px">'+erpEsc(order.observacao_fixada||'')+'</textarea></div></div><div style="margin-top:12px"><div class="field"><label>🟨 ETIQUETAS PERSONALIZADAS</label><div style="display:flex;gap:6px"><input class="input" id="newTag" placeholder="Ex.: Cliente VIP, Frágil..." style="flex:1"><button class="btn blue" id="addTag">ADICIONAR</button></div></div><div class="tag-list" id="tagList">'+tags.map((t,i)=>'<span class="tag-item">'+erpEsc(t)+' <button data-rm-tag="'+i+'">×</button></span>').join('')+'</div></div>';document.getElementById('priority').value=order.prioridade||'Normal';document.getElementById('responsible').value=order.responsavel_atual||'';document.getElementById('saveSummary').onclick=saveSummary;document.getElementById('addTag').onclick=addTag;document.querySelectorAll('[data-rm-tag]').forEach(b=>b.onclick=()=>removeTag(Number(b.dataset.rmTag)))}
async function saveSummary(){const payload={prioridade:document.getElementById('priority').value,responsavel_atual:document.getElementById('responsible').value||null,observacao_fixada:document.getElementById('pinned').value.trim()||null};const {error}=await db.from('pedidos').update(payload).eq('id',id);if(error)erpShowNotice(error.message,true);else{erpShowNotice('Pedido atualizado.');loadAll()}}
async function addTag(){const tag=document.getElementById('newTag').value.trim();if(!tag)return;const tags=[...array(order.etiquetas)];if(!tags.includes(tag))tags.push(tag);await db.from('pedidos').update({etiquetas:tags}).eq('id',id);loadAll()}async function removeTag(i){const tags=[...array(order.etiquetas)];tags.splice(i,1);await db.from('pedidos').update({etiquetas:tags}).eq('id',id);loadAll()}
function renderComments(){const el=document.getElementById('comments');el.innerHTML=comments.length?comments.map(c=>{const p=profileMap[c.usuario_id]||{};return '<div class="comment"><div class="avatar">'+(p.foto_url?'<img src="'+erpEsc(p.foto_url)+'">':'👤')+'</div><div><strong>'+erpEsc(p.nome||p.email||'Funcionário')+'</strong> <time>'+new Date(c.criado_em).toLocaleString('pt-BR')+'</time><p>'+erpEsc(c.texto)+'</p></div></div>'}).join(''):'<div class="empty">Nenhum comentário ainda.</div>'}
