function mentionSearch(){const ta=document.getElementById('commentText'),m=ta.value.match(/@([^@\n]*)$/),box=document.getElementById('mentionBox');if(!m){box.classList.remove('show');return}const q=m[1].toLowerCase().trim();const list=profiles.filter(p=>String(p.nome||'').toLowerCase().includes(q)).slice(0,8);box.innerHTML=list.map(p=>'<div class="mention-item" data-mention="'+p.id+'">@'+erpEsc(p.nome||p.email)+' <span class="muted">'+erpEsc(p.setor||'')+'</span></div>').join('');box.classList.toggle('show',!!list.length);box.querySelectorAll('[data-mention]').forEach(x=>x.onclick=()=>{const p=profileMap[x.dataset.mention];ta.value=ta.value.slice(0,ta.value.length-m[0].length)+'@'+(p.nome||p.email)+' ';box.classList.remove('show');ta.focus()})}
async function sendComment(){const text=document.getElementById('commentText').value.trim();if(!text)return;const mentions=profiles.filter(p=>p.nome&&text.toLowerCase().includes('@'+p.nome.toLowerCase())).map(p=>p.id);const {error}=await db.from('pedido_comentarios').insert({pedido_id:id,usuario_id:currentUser.id,texto:text,mencoes:mentions});if(error)erpShowNotice(error.message,true);else{document.getElementById('commentText').value='';loadComments()}}
async function loadComments(){const {data}=await db.from('pedido_comentarios').select('*').eq('pedido_id',id).order('criado_em');comments=data||[];renderComments()}
async function loadFiles(){const {data}=await db.from('pedido_arquivos').select('*').eq('pedido_id',id).order('criado_em',{ascending:false});files=data||[];const paths=files.map(f=>f.arquivo_path);let map={};if(paths.length){const {data:s}=await db.storage.from('pedido-arquivos').createSignedUrls(paths,3600);(s||[]).forEach(x=>map[x.path]=x.signedUrl)}document.getElementById('files').innerHTML=files.length?files.map(f=>'<div class="file"><strong>'+erpEsc(f.nome_arquivo)+'</strong><small>'+erpEsc(f.descricao||'Sem descrição')+'</small><div style="display:flex;gap:5px;margin-top:8px">'+(map[f.arquivo_path]?'<a class="btn aqua" target="_blank" href="'+erpEsc(map[f.arquivo_path])+'">ABRIR</a>':'')+'<button class="btn red" data-del-file="'+f.id+'">EXCLUIR</button></div></div>').join(''):'<div class="empty" style="grid-column:1/-1">Nenhum arquivo anexado.</div>';document.querySelectorAll('[data-del-file]').forEach(b=>b.onclick=()=>deleteFile(b.dataset.delFile))}
async function uploadFiles(){const list=[...document.getElementById('fileInput').files],desc=document.getElementById('fileDesc').value.trim();if(!list.length)return alert('Selecione arquivos.');for(const f of list){if(f.size>100*1024*1024)return alert('Arquivo acima de 100 MB: '+f.name)}for(const f of list){const safe=f.name.replace(/[^a-zA-Z0-9._-]+/g,'_'),path=currentUser.id+'/'+encodeURIComponent(id)+'/'+Date.now()+'_'+Math.random().toString(36).slice(2,7)+'_'+safe;const {error:u}=await db.storage.from('pedido-arquivos').upload(path,f,{contentType:f.type});if(u)return erpShowNotice(u.message,true);const {error:r}=await db.from('pedido_arquivos').insert({pedido_id:id,usuario_id:currentUser.id,arquivo_path:path,nome_arquivo:f.name,mime_type:f.type,tamanho:f.size,descricao:desc||null});if(r)return erpShowNotice(r.message,true)}document.getElementById('fileInput').value='';erpShowNotice('Arquivos enviados.');loadFiles()}
async function deleteFile(fid){const f=files.find(x=>x.id===fid);if(!f||!confirm('Excluir este arquivo?'))return;await db.storage.from('pedido-arquivos').remove([f.arquivo_path]);await db.from('pedido_arquivos').delete().eq('id',fid);loadFiles()}
function renderQuality(){const state=order.qualidade_checklist||{};document.getElementById('qualityGrid').innerHTML=Object.entries(qualityItems).map(([k,label])=>'<label class="quality-item"><input type="checkbox" data-quality="'+k+'" '+(state[k]?'checked':'')+'> '+label+'</label>').join('');document.getElementById('qualityStatus').innerHTML=order.qualidade_aprovado?'<span class="chip green">APROVADO</span>':'<span class="chip yellow">PENDENTE</span>'}
async function saveQuality(){const obj={};document.querySelectorAll('[data-quality]').forEach(c=>obj[c.dataset.quality]=c.checked);const ok=Object.values(obj).every(Boolean);const payload={qualidade_checklist:obj,qualidade_aprovado:ok,qualidade_aprovado_por:ok?currentUser.id:null,qualidade_aprovado_em:ok?new Date().toISOString():null};const {error}=await db.from('pedidos').update(payload).eq('id',id);if(error)erpShowNotice(error.message,true);else{erpShowNotice(ok?'Checklist aprovado.':'Checklist salvo, ainda pendente.');loadAll()}}
async function renderStock(){document.getElementById('stockItem').innerHTML=stock.map(x=>'<option value="'+erpEsc(x.id)+'">'+erpEsc(x.nome)+' • saldo '+x.quantidade+(x.espessura?' • '+erpEsc(x.espessura):'')+(x.cor?' • '+erpEsc(x.cor):'')+'</option>').join('');document.getElementById('stockLinks').innerHTML=stockLinks.length?stockLinks.map(l=>{const s=stock.find(x=>x.id===l.estoque_id)||{};return '<div class="stock-link"><div><strong>'+erpEsc(s.nome||l.estoque_id)+'</strong><div class="muted" style="font-size:8px">Quantidade: '+l.quantidade+' • saldo atual: '+(s.quantidade??'-')+'</div></div><div>'+ (l.baixado?'<span class="chip green">BAIXADO</span>':'<button class="btn red" data-rm-stock="'+l.id+'">REMOVER</button>')+'</div></div>'}).join(''):'<div class="empty">Nenhum material vinculado.</div>';document.getElementById('stockStatus').innerHTML=order.estoque_baixado?'<span class="chip green">ESTOQUE BAIXADO</span>':'<span class="chip yellow">AGUARDANDO BAIXA</span>';document.querySelectorAll('[data-rm-stock]').forEach(b=>b.onclick=async()=>{await db.from('pedido_estoque_itens').delete().eq('id',b.dataset.rmStock);loadStock()})}
async function addStock(){const estoque_id=document.getElementById('stockItem').value,quantidade=Number(document.getElementById('stockQty').value);if(!estoque_id||quantidade<1)return;const {error}=await db.from('pedido_estoque_itens').upsert({pedido_id:id,estoque_id,quantidade},{onConflict:'pedido_id,estoque_id'});if(error)erpShowNotice(error.message,true);else loadStock()}
async function loadStock(){const [{data:s},{data:l}]=await Promise.all([db.from('estoque').select('*').order('nome'),db.from('pedido_estoque_itens').select('*').eq('pedido_id',id).order('id')]);stock=s||[];stockLinks=l||[];renderStock()}
async function deductStock(){const {data,error}=await db.rpc('baixar_estoque_do_pedido',{p_pedido_id:id});if(error)erpShowNotice(error.message,true);else{erpShowNotice('Estoque baixado: '+(data?.itens||0)+' itens.');loadAll();loadStock()}}
function entityChange(a){const before=a.dados_anteriores||{},after=a.dados_novos||{};const changed=Object.keys(after).filter(k=>JSON.stringify(before[k])!==JSON.stringify(after[k])&&!['atualizado_em','producao_historico','refugos','atraso_historico'].includes(k)).slice(0,7);return changed.length?'Campos: '+changed.join(', '):a.acao}
async function loadHistory(){const [{data:a},{data:s}]=await Promise.all([db.from('auditoria').select('*').eq('tabela','pedidos').eq('registro_id',id).order('criado_em',{ascending:false}).limit(200),db.from('pedido_etapas_historico').select('*').eq('pedido_id',id).order('entrou_em',{ascending:false})]);audit=a||[];stages=s||[];const events=[];audit.forEach(x=>events.push({date:x.criado_em,html:'<strong>'+x.acao+'</strong> • '+erpEsc(entityChange(x))+' • por '+erpEsc(pName(x.usuario_id))}));stages.forEach(x=>events.push({date:x.entrou_em,html:'<strong>Etapa '+erpEsc(ERP_STAGES[x.etapa])+'</strong> • entrou '+new Date(x.entrou_em).toLocaleString('pt-BR')+(x.saiu_em?' • saiu '+new Date(x.saiu_em).toLocaleString('pt-BR')+' • '+erpFmtDuration(x.duracao_segundos):' • em andamento')+(x.responsavel_id?' • '+erpEsc(pName(x.responsavel_id)):'')}));array(order.producao_historico).forEach(x=>events.push({date:x.data,html:'<strong>Produção: '+erpEsc(x.acao)+'</strong> • '+erpEsc(x.etapa||'')+(x.operador?' • '+erpEsc(x.operador):'')}));array(order.atraso_historico).forEach(x=>events.push({date:x.data,html:'<strong>Atraso</strong> • '+erpEsc(x.motivo||'')+' • '+erpEsc(x.etapa||'')}));events.sort((a,b)=>new Date(b.date)-new Date(a.date));document.getElementById('timeline').innerHTML=events.length?events.map(e=>'<div class="event">'+e.html+'<div class="muted" style="font-size:8px;margin-top:4px">'+new Date(e.date).toLocaleString('pt-BR')+'</div></div>').join(''):'<div class="empty">Sem histórico.</div>'}
async function undo(){if(!confirm('Desfazer a última alteração registrada neste pedido?'))return;const {error}=await db.rpc('desfazer_ultima_acao_pedido',{p_pedido_id:id});if(error)erpShowNotice(error.message,true);else{erpShowNotice('Última alteração desfeita.');loadAll();loadHistory()}}
function printSheet(){const w=open('','_blank','width=900,height=700');w.document.write('<html><head><title>Ficha #'+erpEsc(order.id)+'</title><style>body{font-family:Arial;padding:25px}.head{display:flex;justify-content:space-between;border-bottom:3px solid #000;padding-bottom:12px}.id{font-size:38px;font-weight:900}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.box{border:1px solid #bbb;padding:12px}.obs{margin-top:12px;border:2px solid #000;padding:14px}.logo{height:180px;display:grid;place-items:center}.logo img{max-width:100%;max-height:100%}@media print{button{display:none}}</style></head><body><div class="head"><div><div class="id">#'+erpEsc(order.id)+'</div><h2>'+erpEsc(order.cliente||'')+'</h2></div><div>'+erpPriorityChip(order.prioridade)+'</div></div><div class="grid"><div class="box"><b>Saída:</b> '+erpBr(order.prazo)+'</div><div class="box"><b>Marketplace:</b> '+erpEsc(order.marketplace||'-')+'</div><div class="box"><b>Medidas:</b> '+erpEsc(order.medidas||'-')+'</div><div class="box"><b>Espessura:</b> '+erpEsc(order.espessura||'-')+'</div><div class="box"><b>Cor:</b> '+erpEsc(order.cor||'-')+'</div><div class="box"><b>Etapa:</b> '+erpEsc(ERP_STAGES[order.etapa_atual||0])+'</div></div><div class="obs"><b>📌 Observação fixa:</b><br>'+erpEsc(order.observacao_fixada||'-')+'<hr><b>Observações:</b><br>'+erpEsc(order.observacoes||'-')+'</div><div class="logo">'+(order.imagem?'<img src="'+erpEsc(order.imagem)+'">':'SEM LOGO')+'</div><button onclick="print()">IMPRIMIR</button></body></html>');w.document.close()}
function printLabel(){const w=open('','_blank','width=650,height=450');w.document.write('<html><head><title>Etiqueta #'+erpEsc(order.id)+'</title><style>body{font-family:Arial;padding:20px}.l{border:4px solid #000;padding:22px;width:520px}.id{font-size:42px;font-weight:900}.client{font-size:24px;font-weight:800;margin:8px 0}.meta{font-size:16px;line-height:1.5}@media print{button{display:none}}</style></head><body><div class="l"><div class="id">#'+erpEsc(order.id)+'</div><div class="client">'+erpEsc(order.cliente||'')+'</div><div class="meta">Saída: '+erpBr(order.prazo)+'<br>'+erpEsc(order.marketplace||'')+' • '+erpEsc(order.espessura||'')+' • '+erpEsc(order.medidas||'')+'<br>Cor: '+erpEsc(order.cor||'-')+'</div></div><button onclick="print()">IMPRIMIR</button></body></html>');w.document.close()}
async function loadAll(){const [{data:o},{data:p}]=await Promise.all([db.from('pedidos').select('*').eq('id',id).maybeSingle(),db.from('perfis').select('*').order('nome')]);if(!o){document.getElementById('hero').innerHTML='<div class="empty">Pedido não encontrado.</div>';return}order=o;profiles=p||[];profileMap=Object.fromEntries(profiles.map(x=>[x.id,x]));renderHero();renderSummary();renderQuality();document.getElementById('undoBtn').style.display=perms.desfazer?'inline-flex':'none'}
async function init(){if(!id)return document.body.innerHTML='<div class="empty">Informe o pedido na URL.</div>';if(!(await erpRequire(null)))return;currentUser=(await db.auth.getUser()).data.user;perms=await erpGetPermissions();document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab-panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('tab-'+b.dataset.tab).classList.add('active')});document.getElementById('commentText').addEventListener('input',mentionSearch);document.getElementById('sendComment').onclick=sendComment;document.getElementById('uploadFiles').onclick=uploadFiles;document.getElementById('saveQuality').onclick=saveQuality;document.getElementById('addStock').onclick=addStock;document.getElementById('deductStock').onclick=deductStock;document.getElementById('undoBtn').onclick=undo;await loadAll();await Promise.all([loadComments(),loadFiles(),loadStock(),loadHistory()]);db.channel('pedido-central-'+id).on('postgres_changes',{event:'*',schema:'public',table:'pedidos',filter:'id=eq.'+id},loadAll).on('postgres_changes',{event:'*',schema:'public',table:'pedido_comentarios',filter:'pedido_id=eq.'+id},loadComments).on('postgres_changes',{event:'*',schema:'public',table:'pedido_arquivos',filter:'pedido_id=eq.'+id},loadFiles).subscribe()}init();
</script></body></html>
