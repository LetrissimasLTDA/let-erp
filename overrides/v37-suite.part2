    o.producaoStatus="em_andamento";'''
    if anchor not in p: raise SystemExit('Início da produção não encontrado')
    p=p.replace(anchor,repl,1)

# Gate de qualidade e finalização centralizada.
if 'const QUALITY_ITEMS_V37' not in p:
    marker='''/* 6 - finalizar */'''
    js='''const QUALITY_ITEMS_V37={medidas:"Medidas conferidas",cor:"Cor correta",espessura:"Espessura correta",acabamento:"Acabamento aprovado",pecas:"Peças completas",pintura:"Pintura aprovada",embalagem:"Embalagem conferida",foto:"Foto final conferida"};
let qualityGateOrderId=null,qualityGateAfter=null;
function openQualityGate(id,after){
  const o=getOrder(id);if(!o)return;
  qualityGateOrderId=id;qualityGateAfter=after;
  const state=o.qualidadeChecklist||{};
  document.getElementById("qualityGateGrid").innerHTML=Object.entries(QUALITY_ITEMS_V37).map(([k,label])=>'<label><input type="checkbox" data-qv37="'+k+'" '+(state[k]?'checked':'')+'> '+escapeHtml(label)+'</label>').join("");
  document.getElementById("qualityGateError").style.display="none";openModal("qualityGateModal");
}
function completeOrderV37(id,delivered){
  updateOrder(id,o=>{const now=new Date().toISOString();if(o.producaoStatus==="em_andamento"&&o.producaoInicioAtual)o.producaoSegundosAcumulados=(Number(o.producaoSegundosAcumulados)||0)+Math.max(0,Math.floor((Date.now()-new Date(o.producaoInicioAtual).getTime())/1000));o.producaoInicioAtual=null;o.producaoStatus="finalizado";if(!Array.isArray(o.producaoHistorico))o.producaoHistorico=[];o.producaoHistorico.push({tipo:"producao",acao:"finalizado",data:now,etapa:STAGES[Math.min(o.etapaAtual||0,STAGES.length-1)],operador:(o.producaoOperadorAtual||"").trim(),tempoTotal:Number(o.producaoSegundosAcumulados)||0});o.finalizado=true;o.finalizadoEm=now;o.status="Pronto";if(delivered)o.entregueMarketplace=true;if(!o.expedicaoStatus||o.expedicaoStatus==="Aguardando produção")o.expedicaoStatus="Aguardando coleta";});
  showNotice("✓ Pedido #"+id+" aprovado na qualidade e marcado como PRONTO.");refreshActiveModal();
}
document.getElementById("qualityGateConfirm").addEventListener("click",()=>{
