  const central=
    '<button onclick="closeAllMoreMenus();location.href=\\'pedido.html?id='+id+'\\'">CENTRAL DO PEDIDO</button>';

  return '<div class="more-wrap">'+'''
    if old not in p:
        old='''  const mkt=
    '<button class="mkt-option" onclick="closeAllMoreMenus();openMktMaterial(\''+id+'\')">MATERIAL MKT</button>';

