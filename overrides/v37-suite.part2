  return '<div class="more-wrap">'+'''
    if old not in p: raise SystemExit('Material MKT no moreActions não encontrado')
    p=p.replace(old,new,1)
    p=p.replace('analyze+delay+ml+mkt+','analyze+delay+ml+mkt+central+',1)

# Cards: prioridade, tags e observação fixada.
p=p.replace("'<div class=\"order\">PEDIDO #'+escapeHtml(p.id||\"-\")+reenvioTag(p)+'</div>'+", "'<div class=\"order\">PEDIDO #'+escapeHtml(p.id||\"-\")+reenvioTag(p)+priorityTag(p)+'</div>'+",1)
p=p.replace("      '<div class=\"meta\">'+chips+'</div>'+\n      obs+", "      '<div class=\"meta\">'+chips+'</div>'+\n      customTagsHtml(p)+pinnedNoteHtml(p)+\n      obs+",1)
p=p.replace("'<strong>Pedido #'+escapeHtml(p.id)+' • '+escapeHtml(p.cliente||\"Sem cliente\")+'</strong>'+reenvioTag(p)+", "'<strong>Pedido #'+escapeHtml(p.id)+' • '+escapeHtml(p.cliente||\"Sem cliente\")+'</strong>'+reenvioTag(p)+priorityTag(p)+",1)

# Ordenação: prioridade antes do prazo.
p=p.replace('const orders=loadOrders().map(normalizeOrder).sort((a,b)=>String(a.prazo||"").localeCompare(String(b.prazo||"")));','const orders=loadOrders().map(normalizeOrder).sort((a,b)=>(a.prioridade==="Crítico"?0:a.prioridade==="Urgente"?1:2)-(b.prioridade==="Crítico"?0:b.prioridade==="Urgente"?1:2)||String(a.prazo||"").localeCompare(String(b.prazo||"")));',1)

