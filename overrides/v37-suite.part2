    if old not in p: raise SystemExit('orderToDb anchor não encontrado')
    p=p.replace(old,new,1)

# Helpers de prioridade/tags.
if 'function priorityTag(p)' not in p:
    marker='''function cardStatus(p){'''
    helper='''function priorityTag(p){
  if(p.prioridade==="Crítico")return '<span class="priority-tag critical">🔥 CRÍTICO</span>';
  if(p.prioridade==="Urgente")return '<span class="priority-tag urgent">⚡ URGENTE</span>';
  return '';
}
function customTagsHtml(p){
  const tags=Array.isArray(p.etiquetas)?p.etiquetas:[];
  return tags.length?'<div class="custom-tags">'+tags.slice(0,4).map(t=>'<span>'+escapeHtml(t)+'</span>').join('')+'</div>':'';
}
function pinnedNoteHtml(p){return p.observacaoFixada?'<div class="pinned-order-note">📌 '+escapeHtml(p.observacaoFixada)+'</div>':'';}

'''
    if marker not in p: raise SystemExit('cardStatus não encontrado')
    p=p.replace(marker,helper+marker,1)

# Menu 3 pontinhos: central do pedido.
if 'CENTRAL DO PEDIDO' not in p:
    old='''  const mkt=
    '<button class="mkt-option" onclick="closeAllMoreMenus();openMktMaterial(\\''+id+'\\')">MATERIAL MKT</button>';

  return '<div class="more-wrap">'+'''
    new='''  const mkt=
