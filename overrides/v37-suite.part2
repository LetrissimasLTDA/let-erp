    estoqueBaixado:!!r.estoque_baixado,estoqueBaixadoEm:r.estoque_baixado_em||null,etapaIniciadaEm:r.etapa_iniciada_em||null,
    expedicaoStatus:r.expedicao_status||"Aguardando produção",transportadora:r.transportadora||"",codigoRastreio:r.codigo_rastreio||"",
